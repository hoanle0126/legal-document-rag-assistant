{
  "name": "legal-document-rag-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Legal Document Intelligence & RAG System with structured citations and Vietnamese law parsing",
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @legal-rag/api --filter @legal-rag/web dev",
    "dev:api": "pnpm --filter @legal-rag/api dev",
    "dev:web": "pnpm --filter @legal-rag/web dev",
    "build": "pnpm --filter @legal-rag/shared build && pnpm --filter @legal-rag/api build && pnpm --filter @legal-rag/web build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --filter @legal-rag/shared test && pnpm --filter @legal-rag/api test",
    "test:e2e": "pnpm --filter @legal-rag/api test:e2e",
    "db:generate": "pnpm --filter @legal-rag/api prisma:generate",
    "db:migrate": "pnpm --filter @legal-rag/api prisma:migrate",
    "db:seed": "pnpm --filter @legal-rag/api prisma:seed",
    "db:studio": "pnpm --filter @legal-rag/api prisma:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
