generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  USER
}

enum LegalDocumentType {
  LAW
  DECREE
  CIRCULAR
  DECISION
  REGULATION
  RESOLUTION
  ORDER
  DIRECTIVE
  OTHER
}

enum IngestionStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum IngestionSourceType {
  PDF
  TXT
  MARKDOWN
  URL
  MANUAL
}

enum LegalNodeType {
  DOCUMENT
  PART
  CHAPTER
  SECTION
  SUBSECTION
  ARTICLE
  CLAUSE
  POINT
  PARAGRAPH
  UNSTRUCTURED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatSessions ChatSession[]

  @@map("users")
}

model Document {
  id               String            @id @default(uuid())
  title            String
  documentNumber   String?
  documentType     LegalDocumentType @default(LAW)
  issuingAuthority String?
  sourceUrl        String?
  publishedAt      DateTime?
  effectiveAt      DateTime?
  expiredAt        DateTime?
  status           IngestionStatus   @default(PENDING)
  summary          String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions      DocumentVersion[]
  ingestionJobs IngestionJob[]

  @@index([status])
  @@index([documentType])
  @@index([documentNumber])
  @@map("documents")
}

model DocumentVersion {
  id             String              @id @default(uuid())
  documentId     String
  document       Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        Int                 @default(1)
  checksum       String
  rawText        String              @db.Text
  sourceFileName String?
  sourceMimeType String?
  sourceType     IngestionSourceType @default(MANUAL)
  pageCount      Int                 @default(1)
  createdAt      DateTime            @default(now())

  legalNodes LegalNode[]
  chunks     DocumentChunk[]

  @@unique([documentId, version])
  @@index([checksum])
  @@map("document_versions")
}

model LegalNode {
  id                String        @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            LegalNode?    @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          LegalNode[]   @relation("NodeHierarchy")
  type              LegalNodeType @default(UNSTRUCTURED)
  number            String?
  title             String?
  content           String        @db.Text
  originalText      String        @db.Text
  hierarchyPath     String
  page              Int?
  orderIndex        Int           @default(0)
  metadata          Json?

  chunks DocumentChunk[]

  @@index([documentVersionId, orderIndex])
  @@index([hierarchyPath])
  @@map("legal_nodes")
}

model DocumentChunk {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  legalNodeId       String?
  legalNode         LegalNode?      @relation(fields: [legalNodeId], references: [id], onDelete: SetNull)
  content           String          @db.Text
  tokenCount        Int             @default(0)
  article           String?
  clause            String?
  point             String?
  page              Int?
  hierarchyPath     String
  metadata          Json
  embedding         Unsupported("vector(1536)")?
  createdAt         DateTime        @default(now())

  citations RetrievedCitation[]

  @@index([documentVersionId])
  @@index([legalNodeId])
  @@map("document_chunks")
}

model IngestionJob {
  id               String              @id @default(uuid())
  documentId       String
  document         Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status           IngestionStatus     @default(PENDING)
  sourceType       IngestionSourceType
  sourceUrl        String?
  sourceFileName   String?
  errorMessage     String?             @db.Text
  chunksCount      Int                 @default(0)
  processingTimeMs Int?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([documentId])
  @@index([status])
  @@map("ingestion_jobs")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String        @default("Phiên hỏi đáp pháp lý")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id                  String              @id @default(uuid())
  sessionId           String
  session             ChatSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role                String // 'user' | 'assistant' | 'system'
  content             String              @db.Text
  confidence          String? // 'high' | 'medium' | 'low'
  insufficientContext Boolean             @default(false)
  provider            String?
  executionTimeMs     Int?
  createdAt           DateTime            @default(now())
  citations           RetrievedCitation[]

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model RetrievedCitation {
  id            String         @id @default(uuid())
  messageId     String
  message       ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunkId       String?
  chunk         DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  citationIndex Int
  documentTitle String
  documentNumber String?
  article       String?
  clause        String?
  point         String?
  page          Int?
  quote         String         @db.Text
  verified      Boolean        @default(true)
  similarity    Float?
  sourceUrl     String?
  hierarchyPath String?
  createdAt     DateTime       @default(now())

  @@index([messageId])
  @@index([chunkId])
  @@map("retrieved_citations")
}
