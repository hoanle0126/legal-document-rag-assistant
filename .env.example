# Environment Configuration
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=legal_rag_db
DB_PORT=5436
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5436/legal_rag_db?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_URL=redis://localhost:6382

# API Server
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Security & Authentication
JWT_SECRET=legal-rag-secret-jwt-key-minimum-32-characters-for-security
JWT_EXPIRES_IN=7d
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Default Seed Admin User
ADMIN_EMAIL=admin@legalrag.vn
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME="Legal Admin"

# AI Provider Selection
# LLM_PROVIDER: 'mock' | 'openai' | 'gemini' | 'anthropic'
LLM_PROVIDER=mock
# EMBEDDING_PROVIDER: 'mock' | 'openai' | 'gemini'
EMBEDDING_PROVIDER=mock

# AI API Keys (Optional when LLM_PROVIDER=mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# RAG & Retrieval Defaults
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=150
